{
  "components": [
    {
      "id": "in",
      "provider": "webhook",
      "config": {}
    },
    {
      "id": "llm",
      "provider": "llm_openai",
      "config": {
        "model": "gpt-4o-mini",
        "system": "You are an expert AI Marketing copywriter. Your task is to generate a short, high-converting creative brief for a new ad campaign based on the provided campaign context and the top-performing message.\n\nInput context format:\nCampaign: [Name]\nObjective: [Objective]\nAudience: [Audience]\nTop Message: [Top Message]\n\nOutput ONLY a short, punchy paragraph (under 100 words) describing the ad's creative direction, visual tone, and text. Do not output JSON, just the text."
      },
      "input": [
        {
          "lane": "text",
          "from": "in"
        }
      ]
    },
    {
      "id": "out",
      "provider": "response",
      "config": {
        "laneName": "text"
      },
      "input": [
        {
          "lane": "text",
          "from": "llm"
        }
      ]
    }
  ],
  "project_id": "c1ddcbd8-e7af-4897-8ad7-43db3e0806b2"
}